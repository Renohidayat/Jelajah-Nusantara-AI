rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // DENY-ALL: Semua operasi database hanya boleh dilakukan oleh Backend API (Admin SDK).
      // Klien Web dilarang mengakses/mengubah Firestore secara langsung.
      allow read, write: if false;
    }
  }
}
