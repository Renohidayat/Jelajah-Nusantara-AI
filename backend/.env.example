# .env.example - Copy this file to .env and fill in your values

# ════════════════════════════════════════════════════════════
# FIREBASE CONFIGURATION
# ════════════════════════════════════════════════════════════
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyourprivatekeycontent\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/...

# ════════════════════════════════════════════════════════════
# GOOGLE GENERATIVE AI (GEMINI API)
# ════════════════════════════════════════════════════════════
OPENAGENTIC_API_KEY=isi_key_di_sini
AI_VISION_ENABLED=true

# ════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ════════════════════════════════════════════════════════════
PORT=8080
NODE_ENV=development

# ════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ════════════════════════════════════════════════════════════
CORS_ORIGIN=http://localhost:5173

# ════════════════════════════════════════════════════════════
# HOW TO GET THESE VALUES:
# ════════════════════════════════════════════════════════════

# FIREBASE:
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Create a new project or select existing
# 3. Go to Project Settings → Service Accounts
# 4. Click "Generate New Private Key"
# 5. Copy values from the downloaded JSON file
# NOTE: When pasting FIREBASE_PRIVATE_KEY, ensure \n are actual newlines

# GEMINI API KEY:
# 1. Go to Google AI Studio: https://aistudio.google.com/
# 2. Click "Get API Key"
# 3. Create new API key
# 4. Copy and paste here

# ════════════════════════════════════════════════════════════
# SECURITY NOTES:
# ════════════════════════════════════════════════════════════
# - NEVER commit this file to git
# - NEVER share your API keys or credentials
# - Use environment variables in production
# - Keep .env in .gitignore
# - Rotate keys regularly

# ┬┬┬ OpenAgentic AI Config ┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬┬
AI_MODEL=deepseek-v4.1-flash-free
AI_FALLBACK_MODELS=minimax-m3,big-pickle,mimo-v2.6-flash,space-bunny-free,muse-spark-1.3-free
# Batas satu request non-stream, misalnya ekstraksi lokasi peta (ms)
AI_TIMEOUT_MS=120000
# Stream diputus bila tidak ada data sama sekali selama ini (ms)
AI_IDLE_TIMEOUT_MS=60000
# Tenggat total semua percobaan + fallback; harus di bawah maxDuration Vercel 300 dtk (ms)
AI_DEADLINE_MS=280000
